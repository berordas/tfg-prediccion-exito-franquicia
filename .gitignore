# === DATOS PERSONALES — denegación total ==================================
# Se ignora TODO el contenido de data/ sin excepciones: los datos del estudio
# (incluido el dataset seudonimizado) son privados y no se publican en el
# repositorio. Cualquier fichero en data/ queda excluido, lo que evita
# filtrar datos personales por descuido con un `git add -A`.
data/*

# Refuerzo explícito (por si se cambia la regla anterior):
data/bepe/
*.zip
data/dataset_franquicias.xlsx
data/dataset_franquicias.csv
data/ego_*.csv
data/exito_*.xlsx

# === SECRETOS =============================================================
.env
.env.*
*.key
*.pem
secrets.*
credentials.*

# === ARTEFACTOS DE PYTHON =================================================
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/
.venv/
venv/

# === SISTEMA OPERATIVO ====================================================
.DS_Store
Thumbs.db
